{
  "name": "agentrec",
  "version": "0.1.0",
  "description": "Black box recorder for AI agents. Trace, replay, and regression-test every agent run before production.",
  "type": "module",
  "bin": {
    "agentrec": "dist/cli/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ai": {
      "types": "./dist/adapters/ai.d.ts",
      "import": "./dist/adapters/ai.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "example": "tsx examples/basic-agent/agent.ts"
  },
  "keywords": [
    "ai-agents",
    "llm",
    "observability",
    "debugging",
    "replay",
    "evaluation",
    "developer-tools"
  ],
  "author": "Rabuno",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "execa": "^9.6.0",
    "picocolors": "^1.1.1",
    "zod": "^4.1.13"
  },
  "peerDependencies": {
    "ai": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "ai": "7.0.22",
    "tsup": "^8.5.1",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "docs",
    "examples"
  ]
}
